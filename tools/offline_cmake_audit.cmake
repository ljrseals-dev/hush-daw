if(NOT HUSH_SOURCE_ROOT)
  message(FATAL_ERROR "HUSH_SOURCE_ROOT required")
endif()
file(GLOB_RECURSE CMAKES "${HUSH_SOURCE_ROOT}/CMakeLists.txt" "${HUSH_SOURCE_ROOT}/*/CMakeLists.txt")
set(BAD "")
foreach(f ${CMAKES})
  # Skip third-party / Releases archives if any
  string(FIND "${f}" "/Releases/" rel)
  if(NOT rel EQUAL -1)
    continue()
  endif()
  file(READ "${f}" content)
  foreach(pat "FetchContent_Declare" "FetchContent_MakeAvailable" "ExternalProject_Add" "file(DOWNLOAD")
    string(FIND "${content}" "${pat}" pos)
    if(NOT pos EQUAL -1)
      set(BAD "${BAD}\n  ${f}: ${pat}")
    endif()
  endforeach()
endforeach()
if(BAD)
  message(FATAL_ERROR "Offline CMake audit failed:${BAD}")
endif()
message(STATUS "hush_offline_cmake_audit: PASS")
